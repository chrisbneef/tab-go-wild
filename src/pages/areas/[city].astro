---
import Base from '../../layouts/Base.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { CITIES, cityBySlug } from '../../data/cities.js';
import { SERVICES } from '../../data/services.js';
import { serviceSchema, faqSchema, abs } from '../../lib/schema.js';
import { SITE } from '../../config/site.js';
export function getStaticPaths() { return CITIES.map((c) => ({ params: { city: c.slug } })); }
const c = cityBySlug(Astro.params.city);
const url = `/areas/${c.slug}/`;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Service areas', url: '/areas/' }, { name: c.name, url }];
const nearby = c.nearby.map(cityBySlug);
const fmt = (n) => '$' + Math.round(n / 1000).toLocaleString() + 'k';
---
<Base title={`Roofing in ${c.name}, OR: Replacement, Repair & Moss Removal`} description={c.metaDescription} crumbs={crumbs}
  ogImage={`/og/${c.slug}.png`}
  schema={[serviceSchema({ name: `Roofing services in ${c.name}, Oregon`, description: c.metaDescription, url, cityName: c.name }), faqSchema(c.faqs)]}>
  <div class="page-head"><div class="wrap">
    <p class="eyebrow">{c.name}, Oregon</p>
    <h1>{c.headline}</h1>
    <p class="lead" style="max-width:62ch">{c.intro[0]}</p>
    <div class="btn-row"><a class="btn btn-primary" href="#quote">Get a free {c.name} quote</a><a class="btn btn-ghost" href={`/roof-replacement-cost/${c.slug}/`}>Roof cost in {c.name}</a></div>
  </div></div>

  <section style="padding-top:20px"><div class="wrap layout-2">
    <article class="prose">
      <div class="kpis">
        <div class="kpi"><b>{c.census.medianYearBuilt}</b><span>median year homes were built</span></div>
        <div class="kpi"><b>{c.census.ownerShare}%</b><span>owner-occupied homes</span></div>
        <div class="kpi"><b>{fmt(c.census.medianValue)}</b><span>median home value</span></div>
        <div class="kpi"><b>{c.census.population.toLocaleString()}</b><span>residents</span></div>
      </div>
      <p class="small muted" style="margin-top:8px">U.S. Census Bureau, American Community Survey 2020–2024 5-year estimates, via <a href={c.census.profile} rel="nofollow noopener" target="_blank">Census Reporter</a>.</p>

      <p>{c.intro[1]}</p>
      <h2>{c.name}'s homes and roofs</h2>
      <p>{c.housing}</p>
      <h2>Weather, trees and moss</h2>
      <p>{c.weather}</p>
      {c.trees && <p><strong>Tree rules:</strong> {c.trees.text} (<a href={c.trees.url} rel="nofollow noopener" target="_blank">city tree permit info</a>)</p>}

      <h2>Permits in {c.name}</h2>
      <div class="callout">
        <p style="margin-bottom:.5em"><strong>{c.permit.office}</strong>{c.permit.phone && <> · <a href={`tel:+1${c.permit.phone.replace(/\D/g, '')}`}>{c.permit.phone}</a></>} · <a href={c.permit.url} rel="nofollow noopener" target="_blank">building permits page</a></p>
        <p style="margin:0">{c.permit.note}</p>
      </div>

      <h2>Local tips before you hire a roofer</h2>
      <ul>{c.localTips.map((t) => <li>{t}</li>)}</ul>

      <h2>Roofing services in {c.name}</h2>
      <div class="grid g2">
        {SERVICES.map((s) => (
          <a class="card" id={s.slug} href={`/services/${s.slug}/`}>
            <h3 style="font-size:1.05rem">{s.name} in {c.name}</h3>
            <p class="muted small">{s.short}</p>
          </a>
        ))}
      </div>

      {c.neighborhoods.length > 0 && (
        <>
          <h2>{c.name} neighborhoods</h2>
          <p>We cover all of {c.name}, including {c.neighborhoods.slice(0, -1).join(', ')} and {c.neighborhoods.at(-1)}. (<a href={c.neighborhoodsUrl} rel="nofollow noopener" target="_blank">city neighborhood list</a>)</p>
        </>
      )}

      <h2>{c.name} roofing FAQ</h2>
      {c.faqs.map((f) => <details><summary>{f.q}</summary><div class="a">{f.a}</div></details>)}

      <h2>Nearby</h2>
      <ul class="pill-list">
        {nearby.map((n) => <li><a href={`/areas/${n.slug}/`}>Roofing in {n.name}</a></li>)}
        <li><a href={`/roof-replacement-cost/${c.slug}/`}>Roof replacement cost in {c.name}</a></li>
        <li><a href="/areas/">All service areas</a></li>
      </ul>
    </article>
    <aside class="sticky-side"><QuoteForm defaultCity={c.name} heading={`Free roof quote in ${c.name}`} source={`city:${c.slug}`} /></aside>
  </div></section>
  <CtaBand title={`Get your ${c.name} roof sorted before the next storm`} />
</Base>
