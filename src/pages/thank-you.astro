---
import Base from '../layouts/Base.astro';
import { isRented, RENTER } from '../config/site.js';
---
<Base title="Thanks, your request is in" description="Your roof quote request was received. A licensed local roofer will be in touch about your south metro roof." noindex>
  <section><div class="wrap narrow center">
    <h1>Thanks, your request is in.</h1>
    <p class="lead">{isRented() ? `${RENTER.businessName} will call you shortly.` : 'A CCB-licensed local roofer will call you shortly.'} Keep your phone handy.</p>
    <p>While you wait: <a href="/resources/roof-replacement-guide/">download the free roof guide</a> or check the <a href="/resources/storm-leak-checklist/">leak first-steps checklist</a>.</p>
    <p><a class="btn btn-ghost" href="/">Back to home</a></p>
  </div></section>
</Base>
