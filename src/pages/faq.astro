---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { GENERAL_FAQS } from '../data/faqs.js';
import { SERVICES } from '../data/services.js';
import { CITIES } from '../data/cities.js';
import { faqSchema } from '../lib/schema.js';
const crumbs = [{ name: 'Home', url: '/' }, { name: 'FAQ', url: '/faq/' }];
const groups = [
  { title: 'General', faqs: GENERAL_FAQS },
  ...SERVICES.map((s) => ({ title: s.name, faqs: s.faqs, href: `/services/${s.slug}/` })),
  ...CITIES.map((c) => ({ title: c.name, faqs: c.faqs, href: `/areas/${c.slug}/` })),
];
const all = groups.flatMap((g) => g.faqs);
---
<Base title="Roofing FAQ: Costs, Permits, Moss & Insurance in Oregon" description="Answers to common roofing questions for Lake Oswego, West Linn, Oregon City, Gladstone and Milwaukie: costs, permits, CCB licenses, moss, insurance and materials." crumbs={crumbs} schema={[faqSchema(all)]}>
  <div class="page-head"><div class="wrap">
    <h1>Roofing questions, answered plainly</h1>
    <p class="lead" style="max-width:60ch">Costs, permits, licenses, moss, insurance and materials, for Portland's south metro.</p>
  </div></div>
  <section style="padding-top:10px"><div class="wrap narrow">
    {groups.map((g) => (
      <>
        <h2 style="margin-top:1.4em">{g.href ? <a href={g.href} style="color:inherit">{g.title}</a> : g.title}</h2>
        {g.faqs.map((f) => <details><summary>{f.q}</summary><div class="a" set:html={f.a} /></details>)}
      </>
    ))}
  </div></section>
  <CtaBand />
</Base>
