---
import Base from '../../layouts/Base.astro';
import CallPanel from '../../components/CallPanel.astro';
import CallButton from '../../components/CallButton.astro';
import { articleSchema } from '../../lib/schema.js';
const url = '/resources/roof-replacement-guide/';
const title = "Oregon Homeowner's Roof Replacement Guide & Checklist (Free PDF)";
const desc = 'A free, printable guide for Oregon homeowners planning a new roof: signs it\'s time, materials for our rain and moss, vetting a CCB-licensed roofer, reading bids, permits, insurance and a checklist.';
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Guides & tools', url: '/resources/' }, { name: 'Roof replacement guide', url }];
---
<Base title={title} description={desc} crumbs={crumbs} ogImage="/og/guide.jpg" schema={[articleSchema({ headline: title, description: desc, url })]}>
  <div class="page-head"><div class="wrap">
    <h1>The Oregon Homeowner's Roof Replacement Guide</h1>
    <p class="lead" style="max-width:62ch">Eight printable pages that walk you from "is it time?" to a signed contract you feel good about, written for Willamette Valley weather and Oregon's contractor rules.</p>
    <div class="btn-row"><a class="btn btn-primary" href="/downloads/oregon-roof-replacement-guide.pdf" download>Download the free PDF</a><CallButton label="Call a roofer" showNumber={false} variant="ghost" /></div>
  </div></div>
  <section style="padding-top:20px"><div class="wrap layout-2">
    <article class="prose">
      <h2>What's inside</h2>
      <ol>
        <li><strong>Is it time?</strong> The 10 signs that mean repair, and the ones that mean replace.</li>
        <li><strong>Materials for Oregon.</strong> Asphalt, metal, cedar and flat roofs compared for rain, shade and moss.</li>
        <li><strong>What it costs.</strong> Published Portland-area ranges, with sources, and what moves a bid.</li>
        <li><strong>Vetting a roofer.</strong> How to check an Oregon CCB license, bond and complaint history in five minutes.</li>
        <li><strong>Reading a bid.</strong> The 12 things a good written bid includes, and red flags.</li>
        <li><strong>Permits, HOAs and trees.</strong> State permit rule plus each south metro city's building office.</li>
        <li><strong>Insurance and storms.</strong> What policies usually cover and how to document damage.</li>
        <li><strong>After the roof.</strong> Moss care, gutters and a yearly maintenance checklist.</li>
      </ol>
      <p>No email needed: it's a direct download. Print it, mark it up, and bring it to your bid appointments.</p>
      <p><a class="btn btn-primary" href="/downloads/oregon-roof-replacement-guide.pdf" download>Download the guide (PDF)</a></p>
      <h2>Quick version: 5 things to do before you sign</h2>
      <ol>
        <li>Look up the roofer's CCB number at <a href="https://search.ccb.state.or.us/search/" rel="noopener">search.ccb.state.or.us</a>.</li>
        <li>Get the bid in writing, with materials, underlayment, ventilation and the per-sheet decking price.</li>
        <li>Ask who pulls the permit, if one's needed.</li>
        <li>Get both warranties in writing: the manufacturer's and the roofer's workmanship warranty.</li>
        <li>Never pay in full up front. Oregon requires a written contract for jobs over $2,000.</li>
      </ol>
    </article>
    <aside class="sticky-side"><CallPanel context="replacing your roof" /></aside>
  </div></section>
</Base>
