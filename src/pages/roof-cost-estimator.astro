---
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import SourceList from '../components/SourceList.astro';
import { MATERIAL_RATES, PITCH } from '../data/costs.js';
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Roof cost estimator', url: '/roof-cost-estimator/' }];
const data = JSON.stringify({ rates: MATERIAL_RATES, pitch: PITCH });
const keys = Object.values(MATERIAL_RATES).flatMap((r) => r.srcs);
const schema = [{ '@type': 'WebApplication', name: 'Oregon Roof Replacement Cost Estimator', applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, url: 'https://www.willamettefallsroofing.com/roof-cost-estimator/' }];
---
<Base title="Roof Replacement Cost Estimator for Oregon Homes (2026)" description="Free roof cost estimator for Lake Oswego, West Linn, Oregon City and the Portland area. Enter your home size, pitch and material for a price range based on published cost data." crumbs={crumbs} schema={schema}>
  <div class="page-head"><div class="wrap">
    <p class="eyebrow">Free tool</p>
    <h1>Roof replacement cost estimator</h1>
    <p class="lead" style="max-width:60ch">A quick range for your home, built from published Oregon and Portland-area cost data. Every source is listed below the tool.</p>
  </div></div>
  <section style="padding-top:20px"><div class="wrap layout-2">
    <div>
      <div class="est" id="estimator" data-cfg={data}>
        <div class="row2">
          <div class="field"><label for="e-sqft">Home size (heated sq ft)</label><input id="e-sqft" type="number" inputmode="numeric" min="400" max="10000" step="50" value="2000" /></div>
          <div class="field"><label for="e-stories">Stories</label><select id="e-stories"><option value="1">1</option><option value="2" selected>2</option><option value="3">3</option></select></div>
        </div>
        <div class="row2">
          <div class="field"><label for="e-pitch">Roof pitch</label><select id="e-pitch">{Object.entries(PITCH).map(([k, p]) => <option value={k} selected={k === 'medium'}>{p.label}</option>)}</select></div>
          <div class="field"><label for="e-mat">Material</label><select id="e-mat">{Object.entries(MATERIAL_RATES).map(([k, r]) => <option value={k}>{r.label}</option>)}</select></div>
        </div>
        <div class="est-out" aria-live="polite">
          <div class="small muted">Estimated range</div>
          <div class="est-range" id="e-range">–</div>
          <div class="small" id="e-area"></div>
          <p class="small muted" id="e-note" style="margin:.6em 0 0"></p>
        </div>
        <p class="small" style="margin-top:14px"><strong>Want a firm number?</strong> Send this estimate with your request and a CCB-licensed local roofer will price your actual roof.</p>
        <a class="btn btn-primary" href="#quote" style="width:100%">Get an exact quote</a>
      </div>
      <div class="prose" style="margin-top:28px">
        <h2>How the estimate works</h2>
        <ol>
          <li><strong>Footprint:</strong> home size ÷ stories (a rough stand-in for the area under the roof).</li>
          <li><strong>Roof area:</strong> footprint × a pitch factor (1.15 low, 1.25 medium, 1.45 steep) that accounts for slope and typical overhangs.</li>
          <li><strong>Price:</strong> roof area × the published installed cost per square foot for the material, low to high, rounded to $500.</li>
        </ol>
        <p>It doesn't know about extra layers, rotted decking, chimneys, skylights, access or your HOA. Those are why a written bid after an inspection is the only real price. Garages and covered porches add roof area too.</p>
        <p><a href="/roof-replacement-cost/">Read the full roof cost guide →</a></p>
        <SourceList keys={keys} />
      </div>
    </div>
    <aside class="sticky-side"><QuoteForm heading="Get an exact quote" defaultService="Roof Replacement" source="estimator" /></aside>
  </div></section>
</Base>
<script>
  const root = document.getElementById('estimator');
  if (root) {
    const cfg = JSON.parse(root.dataset.cfg);
    const $ = (id) => document.getElementById(id);
    const r500 = (n) => Math.round(n / 500) * 500;
    const money = (n) => '$' + r500(n).toLocaleString();
    function calc() {
      const sqft = Math.max(400, Math.min(10000, Number($('e-sqft').value) || 0));
      const stories = Number($('e-stories').value) || 1;
      const pitch = cfg.pitch[$('e-pitch').value];
      const mat = cfg.rates[$('e-mat').value];
      const area = (sqft / stories) * pitch.factor;
      const lo = area * mat.low, hi = area * mat.high;
      $('e-range').textContent = `${money(lo)} – ${money(hi)}`;
      $('e-area').textContent = `≈ ${Math.round(area).toLocaleString()} sq ft of roof (${(area / 100).toFixed(1)} squares) · ${mat.label}`;
      $('e-note').textContent = mat.note;
      try { sessionStorage.setItem('wfr_estimate', `${mat.label}, ${sqft} sq ft, ${stories} story, ${pitch.label}: ${money(lo)}–${money(hi)}`); } catch {}
    }
    root.querySelectorAll('input,select').forEach((el) => el.addEventListener('input', calc));
    calc();
  }
</script>
