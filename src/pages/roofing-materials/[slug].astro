---
import Base from '../../layouts/Base.astro';
import CallPanel from '../../components/CallPanel.astro';
import CallButton from '../../components/CallButton.astro';
import SourceList from '../../components/SourceList.astro';
import Photo from '../../components/Photo.astro';
import { SERVICE_PHOTO } from '../../data/photos.js';
import { MATERIALS } from '../../data/services.js';
import { MATERIAL_RATES } from '../../data/costs.js';
import { articleSchema } from '../../lib/schema.js';
export function getStaticPaths() { return MATERIALS.map((m) => ({ params: { slug: m.slug } })); }
const m = MATERIALS.find((x) => x.slug === Astro.params.slug);
const r = MATERIAL_RATES[m.costKey];
const url = `/roofing-materials/${m.slug}/`;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Roofing materials', url: '/roofing-materials/' }, { name: m.name, url }];
const title = `${m.name} Roofs in Oregon: Cost, Lifespan, Pros & Cons`;
const desc = `${m.name} for south metro Portland homes: published installed cost ($${r.low}–$${r.high} per sq ft), lifespan, pros and cons in Oregon's rain and moss, and who it's best for.`;
const others = MATERIALS.filter((x) => x.slug !== m.slug);
const sqft2000 = 2000 / 2 * 1.25;
---
<Base title={title} description={desc} crumbs={crumbs} schema={[articleSchema({ headline: title, description: desc, url })]}>
  <div class="page-head"><div class="wrap">
    <h1>{m.name}</h1>
    <p class="lead">{m.short}</p>
    <div class="btn-row"><CallButton label="Call" /><a class="btn btn-ghost" href="/roof-cost-estimator/">Estimate my cost</a></div>
  </div></div>
  <section style="padding-top:0"><div class="wrap layout-2">
    <article class="prose">
      <figure class="figure"><Photo slot={SERVICE_PHOTO[m.slug]} sizes="(min-width:1000px) 640px, 100vw" widths={[480, 800, 1200]} /></figure>
      <div class="table-scroll"><table>
        <tbody>
          <tr><th scope="row">Installed cost (published)</th><td>${r.low}–${r.high} per sq ft</td></tr>
          <tr><th scope="row">Example: 2,000 sq ft two-story home*</th><td>${Math.round(sqft2000 * r.low / 100) * 100 / 1000}k–${Math.round(sqft2000 * r.high / 100) * 100 / 1000}k</td></tr>
        </tbody>
      </table></div>
      <p class="small muted" style="margin-top:8px">*About {Math.round(sqft2000).toLocaleString()} sq ft of roof (1,000 sq ft footprint × 1.25 for a medium pitch and overhangs). {r.note}</p>
      <h2>How long it lasts</h2>
      <p>{m.lifespan}</p>
      <h2>Pros</h2><ul>{m.pros.map((x) => <li>{x}</li>)}</ul>
      <h2>Cons</h2><ul>{m.cons.map((x) => <li>{x}</li>)}</ul>
      <h2>Best for</h2><p>{m.bestFor}</p>
      <p><a href="/roof-cost-estimator/">Estimate a {m.name.toLowerCase()} roof for your home</a></p>
      <h2>Compare other materials</h2>
      <ul class="pill-list">{others.map((o) => <li><a href={`/roofing-materials/${o.slug}/`}>{o.name}</a></li>)}</ul>
      <SourceList keys={r.srcs} />
    </article>
    <aside class="sticky-side"><CallPanel context={`a ${m.name.toLowerCase()} roof`} /></aside>
  </div></section>
</Base>
