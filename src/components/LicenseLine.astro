---
import { SITE, RENTER, isRented } from '../config/site.js';
---
{isRented()
  ? <p>Roofing services on this site are provided by <strong>{RENTER.businessName}</strong>, Oregon CCB #{RENTER.ccbNumber}. Verify any Oregon contractor's license at <a href="https://search.ccb.state.or.us/search/" rel="noopener">the Oregon Construction Contractors Board</a>.</p>
  : <p><strong>{SITE.name} is not a roofing contractor</strong> and does not perform roofing work. We publish local roofing information and connect callers with an independent, Oregon CCB-licensed roofer serving their area, whose business name and CCB # you'll get before any work is agreed. Always verify a contractor's license at <a href="https://search.ccb.state.or.us/search/" rel="noopener">the Oregon CCB</a>.</p>}
