---
import Photo from './Photo.astro';
import { SERVICES } from '../data/services.js';
import { SERVICE_PHOTO } from '../data/photos.js';
const { city = null, exclude = null, two = true } = Astro.props;
const list = SERVICES.filter((s) => s.slug !== exclude);
---
<ul class={`svc-list ${two ? 'two' : ''}`}>
  {list.map((s) => (
    <li id={city ? s.slug : undefined}>
      <a href={`/services/${s.slug}/`}>
        <span class="thumb"><Photo slot={SERVICE_PHOTO[s.slug]} alt="" sizes="96px" widths={[96, 192]} /></span>
        <span>
          <h3>{city ? `${s.name} in ${city}` : s.name}</h3>
          <p>{s.short}</p>
        </span>
      </a>
    </li>
  ))}
</ul>
