---
import CallButton from './CallButton.astro';
import { activePhone, telHref } from '../config/site.js';
const { title = 'Get your roof sorted before the next storm.', text = "Call to talk with a local, CCB-licensed roofer. If we miss you, leave a message and we'll get back to you." } = Astro.props;
const phone = activePhone();
---
<section class="cta-band">
  <div class="wrap">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="right">
      <a class="num" href={telHref()} data-call>{phone.display}</a>
      <div class="btn-row">
        <CallButton label="Call now" showNumber={false} size="lg" />
        <a class="btn btn-on-dark btn-lg" href="/roof-cost-estimator/">Estimate my cost</a>
      </div>
    </div>
  </div>
</section>
