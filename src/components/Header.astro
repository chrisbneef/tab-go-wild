---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import CallButton from './CallButton.astro';
import { SITE, brandName, isRented } from '../config/site.js';
const links = [
  ['/services/', 'Services'],
  ['/areas/', 'Areas'],
  ['/roof-replacement-cost/', 'Costs'],
  ['/roof-cost-estimator/', 'Estimator'],
  ['/resources/', 'Guides'],
  ['/how-it-works/', 'How it works'],
];
const here = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/" aria-label={`${brandName()} home`}>
      <Logo />
      <span>{brandName()}<small>{isRented() ? 'Lake Oswego, West Linn and Oregon City' : SITE.tagline}</small></span>
    </a>
    <nav class="nav" aria-label="Main">
      {links.map(([href, label]) => <a href={href} aria-current={here.startsWith(href) ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="header-cta">
      <CallButton label="Call" />
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mnav" aria-label="Open menu" data-menu><Icon name="menu" /></button>
    </div>
  </div>
  <nav id="mnav" class="mobile-nav" aria-label="Mobile">
    {links.map(([href, label]) => <a href={href}>{label}</a>)}
    <a href="/faq/">FAQ</a>
  </nav>
</header>
<script>
  const b = document.querySelector('[data-menu]');
  const n = document.getElementById('mnav');
  if (b && n) b.addEventListener('click', () => {
    const open = n.classList.toggle('open');
    b.setAttribute('aria-expanded', String(open));
  });
</script>
